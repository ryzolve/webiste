# Public build-time config for production builds (`vinext build`), committed so
# a deploy from any machine gets it. Cloudflare's build variables used to supply
# these; deploys from a laptop had neither, which left every site form posting
# to ryzolve.com itself (404) with a blank Turnstile key. Public values only:
# NEXT_PUBLIC_* is inlined into the client bundle.
NEXT_PUBLIC_API_URL=https://api.ryzolve.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADk93t9k4jQAEWqf
