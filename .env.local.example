# ryzolve-api base URL (no trailing slash)
# Production: https://api.ryzolve.app
NEXT_PUBLIC_API_URL=https://api.ryzolve.app

# Cloudflare Turnstile site key
# The test key below ALWAYS passes — safe for local dev and CI.
# Replace with your real site key from https://dash.cloudflare.com/?to=/:account/turnstile
# Test key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
