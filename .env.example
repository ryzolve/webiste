# ───────────────────────────────────────────────────────────────
# Ryzolve marketing website — public runtime config.
# Copy to .env.local for local dev. All NEXT_PUBLIC_* values are
# embedded in the client bundle, so keep secrets out of this file.
# ───────────────────────────────────────────────────────────────

# Canonical base URL for SEO (canonical tags, OG image, sitemap, JSON-LD).
# The marketing site is served at home.ryzolve.com because the apex
# ryzolve.com is occupied by another app and 301-redirects here.
NEXT_PUBLIC_SITE_URL=https://home.ryzolve.com

# SEO / analytics (optional — leave unset to disable)
# Google Search Console: the token from the "HTML tag" verification method
# (just the content value, not the full meta tag).
NEXT_PUBLIC_GSC_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Learner + agency training platforms (CTA destinations)
NEXT_PUBLIC_RYZOLVE_TRAINING=https://learn.ryzolve.app
NEXT_PUBLIC_RYZOLVE_AGENCY=https://agency.ryzolve.app

# Public courses/plans API (administrator courses + in-service plans)
NEXT_PUBLIC_RYZOLVE_COURSES_API=https://api.ryzolve.app
NEXT_PUBLIC_API_URL=https://api.ryzolve.app

# Lead-magnet + contact form submission API
# (Cloudflare Turnstile site key for the form widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Legacy CMS (only used by older non-redesign pages, if present)
NEXT_PUBLIC_STRAPI_URL=
NEXT_PUBLIC_GRAPHQL=
